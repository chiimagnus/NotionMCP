# 项目运行配置。不要把 MCP_TOKEN 写进这里。

MCP_SANDBOX_DIR_MACOS=~/Github_OpenSource/AI-Share
MCP_SANDBOX_DIR_WINDOWS=~/AI-Share
MCP_SKILLS_DIR=~/.codex/skills
MCP_LOG_FILE=exec.log
MCP_WINDOWS_TOKEN_FILE=~/.mcp/token.enc

MCP_PROXY_PORT=8000
MCP_UPSTREAM_PORT=8001
MCP_SESSION_TIMEOUT_MS=3600000
MCP_DEFAULT_TIMEOUT_MS=120000
MCP_MAX_TIMEOUT_MS=3600000
MCP_MAX_OUTPUT_CHARS=100000
MCP_DEFAULT_IMAGE_MAX_SIZE=1024
MCP_MAX_IMAGE_MAX_SIZE=2000

MCP_TOKEN_SERVICE=mcp-token
MCP_TAILSCALE_PATH_MACOS=/Applications/Tailscale.app/Contents/MacOS/Tailscale
MCP_TAILSCALE_PATH_WINDOWS=tailscale.exe
