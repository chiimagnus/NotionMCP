# NotionMCP 运行配置（KEY=VALUE 格式）。
# 路径里的 ~ 表示当前用户的 home 目录。
# 不要把 MCP_TOKEN 写进这里：macOS 从钥匙串读取，Windows 从 DPAPI 文件读取。

# ============================================================================
# 通用配置（macOS 和 Windows 共用）
# ============================================================================

# 鉴权代理监听端口；这个端口才允许暴露给 Tailscale Funnel。
MCP_PROXY_PORT=8000
# MCP 后端端口；不要直接暴露到公网。
MCP_UPSTREAM_PORT=8001
# Streamable HTTP session 的最长存活时间，单位：毫秒。
MCP_SESSION_TIMEOUT_MS=3600000

# run_command 的默认/最大超时时间，单位：毫秒。
MCP_DEFAULT_TIMEOUT_MS=120000
MCP_MAX_TIMEOUT_MS=3600000
# 单次命令最多返回的字符数。
MCP_MAX_OUTPUT_CHARS=100000
# SVG 栅格化的默认/最大尺寸，单位：像素。
MCP_DEFAULT_IMAGE_MAX_SIZE=1024
MCP_MAX_IMAGE_MAX_SIZE=2000

# ============================================================================
# macOS 配置
# ============================================================================

# run_command、read_image 等工具使用的默认工作目录。
MCP_SANDBOX_DIR_MACOS=~/Github_OpenSource/AI-Share
# load_skills 扫描的技能目录。
MCP_SKILLS_DIR=~/.codex/skills
# exec.log 的路径；相对路径以项目根目录为基准。
MCP_LOG_FILE=exec.log
# macOS 钥匙串中的 generic password service 名称。
MCP_TOKEN_SERVICE=mcp-token
# Tailscale CLI 路径；如果 tailscale 已在 PATH 中，up.sh 会优先使用 PATH 版本。
MCP_TAILSCALE_PATH_MACOS=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# ============================================================================
# Windows 配置
# ============================================================================

# Filesystem MCP 允许访问的目录。
MCP_SANDBOX_DIR_WINDOWS=~/AI-Share
# DPAPI 加密 Token 文件路径。
MCP_WINDOWS_TOKEN_FILE=~/.mcp/token.enc
# Tailscale CLI 路径；如果不在 PATH，请改成 tailscale.exe 的完整路径。
MCP_TAILSCALE_PATH_WINDOWS=tailscale.exe
