# NotionMCP 用户配置（KEY=VALUE 格式）。

# ============================================================================
# 通用配置
# ============================================================================

# MCP 仅在本机监听的端口；Tailscale Funnel 指向这里。
MCP_PORT=8000

# ============================================================================
# macOS 配置
# ============================================================================

MCP_SANDBOX_DIR_MACOS=~/AI-Share
MCP_SKILLS_DIR_MACOS=~/.codex/skills
# 可选：逗号分隔要跳过的 SKILL.md name；不存在的名称会被忽略。
# SKILLS_IGNORE_MACOS=imagegen,blender

# ============================================================================
# Linux 配置
# ============================================================================

MCP_SANDBOX_DIR_LINUX=~/AI-Share
MCP_SKILLS_DIR_LINUX=~/.codex/skills
# 可选：逗号分隔要跳过的 SKILL.md name；不存在的名称会被忽略。
# SKILLS_IGNORE_LINUX=imagegen,blender
MCP_TOKEN_LINUX=请替换为随机生成的64位十六进制字符串

# ============================================================================
# Windows 配置
# ============================================================================

MCP_SANDBOX_DIR_WINDOWS=~/AI-Share
MCP_SKILLS_DIR_WINDOWS=~/.codex/skills
# 可选：逗号分隔要跳过的 SKILL.md name；不存在的名称会被忽略。
# SKILLS_IGNORE_WINDOWS=imagegen,blender
MCP_TOKEN_WINDOWS=请替换为随机生成的64位十六进制字符串
