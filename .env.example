# NotionMCP 用户配置（KEY=VALUE 格式）。

# ============================================================================
# 通用配置
# ============================================================================

# 鉴权代理监听端口；这个端口才允许暴露给 Tailscale Funnel。
MCP_PROXY_PORT=8000
# MCP 后端端口；不要直接暴露到公网。
MCP_UPSTREAM_PORT=8001

# 高级/可选：supergateway、auth-proxy 定期自动回收重启的间隔（毫秒），用于规避
# 长时间运行后可能出现的会话/孤儿子进程积累。默认 21600000（6 小时）。设为 0
# 关闭定期回收。绝大多数用户不需要改这个值，取消注释并修改即可覆盖默认值。
# MCP_RECYCLE_INTERVAL_MS=21600000

# ============================================================================
# macOS 配置
# ============================================================================

# run_command、read_image 等工具使用的默认工作目录。
MCP_SANDBOX_DIR_MACOS=~/Github_OpenSource/AI-Share
# load_skills 扫描的 macOS 技能目录。
MCP_SKILLS_DIR_MACOS=~/.codex/skills

# ============================================================================
# Linux 配置
# ============================================================================

MCP_SANDBOX_DIR_LINUX=~/AI-Share
# load_skills 扫描的 Linux 技能目录。
MCP_SKILLS_DIR_LINUX=~/.codex/skills

# ============================================================================
# Windows 配置
# ============================================================================

MCP_SANDBOX_DIR_WINDOWS=~/AI-Share
# load_skills 扫描的 Windows 技能目录。
MCP_SKILLS_DIR_WINDOWS=~/.codex/skills
